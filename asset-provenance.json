      "roles": [
        {
          "description": "为你的唯一可玩场景提供 2D 固定全景：开放式院子、前方小水塘、羊圈和类似欧洲阿尔卑斯山脉的远景，并以可分层的水粉涂感表现天气、季节与天光变化。",
          "id": "fixed_yard_panorama",
          "label": "固定院子全景与水粉环境层"
        },
        {
          "description": "为你的走近、喂草、牵行草泥马和发呆观看提供简洁可读的 2D 毛毡角色；角色应融入固定院子尺度，不呈现农场主、战斗者或 RPG 英雄气质。",
          "id": "vacationer_character",
          "label": "被放假的玩家角色"
        },
        {
          "description": "为你的表情收集主线提供一只高辨识度的 2D 毛毡草泥马，支持待机、走动、吃草、被牵行、多组情绪表情，以及用毛球粒子而非液体表现吐痰。",
          "id": "alpaca_main_character",
          "label": "草泥马主线动物"
        },
        {
          "description": "为你的小水塘和动物关系条件提供几只 2D 毛毡鸭子，支持成群待机、缓慢移动、进食及可被相册捕捉的表情变化。",
          "id": "duck_group",
          "label": "水塘鸭群"
        },
        {
          "description": "为你的羊圈和草泥马互动条件提供两只可区分但风格统一的 2D 毛毡羊，支持待机、移动、吃草与基础表情变化。",
          "id": "sheep_pair",
          "label": "羊圈双羊"
        },
        {
          "description": "为你的同地吃草和动物空间关系条件提供一只 2D 毛毡牛，支持待机、缓慢移动、吃草及基础表情变化。",
          "id": "cow_character",
          "label": "独立牛角色"
        },
        {
          "description": "为你的阴天靠近草泥马等关系触发提供一只轮廓清晰的 2D 毛毡大鹅，支持待机、行走、靠近及基础表情变化。",
          "id": "goose_character",
          "label": "独立大鹅角色"
        },
        {
          "description": "为你的数据驱动表情系统提供可替换的眼睛、嘴和耳朵层，使草泥马主线表情及其他动物支线表情在轻推近镜头时仍清晰，并保持手作毛毡质感。",
          "id": "modular_animal_faces",
          "label": "动物可替换表情层"
        },
        {
          "description": "为你的偶遇表情收藏提供简体中文手帐与拍立得相册框架；不使用 RPG 面板、任务红点、倒计时、金币、体力或“今日待办”式视觉。",
          "id": "polaroid_scrapbook_ui",
          "label": "手帐式拍立得相册界面"
        }
      ]
    },
